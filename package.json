{
  "name": "mvburguerback",
  "version": "1.0.0",
  "description": "REST API para uma hamburgueria digital com autenticação, pedidos, painel administrativo e pagamentos via Stripe",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "sequelize db:migrate",
    "check": "biome check src",
    "format": "biome format --write src"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "postgresql",
    "stripe",
    "jwt",
    "e-commerce"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "stripe": "^22.5.0",
    "uuid": "^13.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "sequelize-cli": "^6.6.5"
  }
}
